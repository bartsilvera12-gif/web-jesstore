# =============================================================
# JESS STORE · Variables de entorno para Supabase self-hosted
# Copiá este archivo a `.env` y completá los valores.
# =============================================================

# URL pública del gateway (Kong) de tu Supabase self-hosted.
# En desarrollo local suele ser http://localhost:8000
SUPABASE_URL=http://localhost:8000

# Anon key (pública, se puede exponer al navegador).
# La ves en Supabase Studio → Settings → API.
SUPABASE_ANON_KEY=REEMPLAZAR_CON_ANON_KEY

# Service role key (privada, solo para el admin/panel — NO va al navegador).
SUPABASE_SERVICE_ROLE_KEY=REEMPLAZAR_CON_SERVICE_ROLE_KEY

# Cadena de conexión directa a Postgres (para correr los .sql con psql).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres
